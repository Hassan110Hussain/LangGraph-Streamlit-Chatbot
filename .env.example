# ============================================================
# Environment Variables — copy this file to .env and fill in
# ============================================================
# NEVER commit your real .env file. This file is safe to commit.
# ============================================================

# AI Provider selection: "gemini" or "openai"
# Default: gemini
AI_PROVIDER=gemini

# ------------------------------------------------------------------
# Google Gemini (required when AI_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GOOGLE_API_KEY=

# ------------------------------------------------------------------
# OpenAI (required when AI_PROVIDER=openai)
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------
# Alpha Vantage (optional — only needed for the stock price tool)
# Free tier at: https://www.alphavantage.co/support/#api-key
# ------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------
# Demo Mode
# Set to "true" to run without any API keys.
# Responses will be clearly labeled as simulated.
# ------------------------------------------------------------------
DEMO_MODE=false
